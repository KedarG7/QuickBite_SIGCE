{
  "name": "sigce-canteen-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "mobile:add-android": "npm run mobile:add-android -w apps/web",
    "mobile:sync": "npm run mobile:sync -w apps/web",
    "mobile:android": "npm run mobile:android -w apps/web",
    "start": "npm run start -w apps/api",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
